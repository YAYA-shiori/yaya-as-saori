// YAYAビルトイン(システム)関数モジュール
//
// SAORI の Argument0 に YAYA 本体のシステム関数名が来ると、ayasaori.aym が AYASAORI.CallBuiltin を呼ぶ。
// 本体の関数は個別の wrapper を書かなくても、そのまま呼べる(YAYA に関数が増えても自動で使える)。
//
//   Argument1.. → 引数(すべて文字列で届く。数値が要る引数だけ AYASAORI.ArgSig で変換する)
//   戻り値      → 整数・実数・文字列は Result、配列は Value0..n、ハッシュは Result(SERIALIZEVAR の書式)
//   引数が足りない(本体が W0008 を出した) → 400 Bad Request
//
// 関数の追加や調整の仕方
//   ・普通の関数            : 何も書かなくてよい
//   ・数値の引数がある関数  : AYASAORI.ArgSig に型を書く
//   ・配列を返して Result に個数や連結文字列も欲しい関数 : AYASAORI.ArrayResult に書く
//   ・それ以外の特殊な返し方 : 関数名を小文字にした個別 wrapper をこのファイルや別の .aym に書く
//                               (例: fread。個別 wrapper があればそちらが優先される)。
//                               引数は REQ.ARGS、結果は RES.RESULT / RES.VALUEn に入れる。
//                               引数が足りないときは -1 を返す(400 Bad Request になる)

// #define はファイルごとに有効なので、ayasaori.aym のものはここでは使えない
#define FUNC_USER	1		/* ISFUNC の戻り値: ユーザ関数 */
#define FUNC_BUILTIN	2		/* ISFUNC の戻り値: 本体のシステム関数 */
#define CRLF		CHR(0xd)+CHR(0xa)	/* 改行コード */


/**	本体のシステム関数を呼び、結果を RES.* に入れる
 *
 *	@param	string	_argv[0] 本体の関数名(GETSYSTEMFUNCLIST の綴り)
 *	@return	int		-1 なら 400 Bad Request
 */
AYASAORI.CallBuiltin
{
	_name = _argv[0]

	// 個別 wrapper があれば優先する
	_wrapper = TOLOWER(_name)
	if ISFUNC(_wrapper) == FUNC_USER {
		return EVAL(_wrapper)
	}

	// EVAL に渡す文字列を組み立てるので、本体に実在する関数名だけを通す。内部用の名前は呼べない
	if ISFUNC(_name) != FUNC_BUILTIN || _name == 'EmBeD_HiStOrY' {
		return -1
	}

	// 引数を型ヒントどおりに変換する。末尾の空の引数は、省略できるもの(型ヒントが大文字)なら渡さない
	// 型ヒントが無い関数(ほとんど)は、そのまま渡す
	_sig  = AYASAORI.ArgSig(_name)
	_args = REQ.ARGS
	if _sig != '' {
		_keep = ARRAYSIZE(REQ.ARGS)
		while _keep > 0 && REQ.ARGS[_keep - 1] == '' && RE_MATCH(SUBSTR(_sig, _keep - 1, 1), '[A-Z]') {
			_keep -= 1
		}
		_args = IARRAY()
		for _i = 0; _i < _keep; _i++ {
			_value = REQ.ARGS[_i]
			case TOLOWER(SUBSTR(_sig, _i, 1)) {
			when 'i' { _value = TOINT(_value) }
			when 'r' { _value = TOREAL(_value) }
			when 'a' { _value = TOAUTO(_value) }
			when 'x' { _value = TOAUTOEX(_value) }
			}
			_args ,= _value
		}
	}

	// 配列は関数の引数に展開されるので、本体の関数にそのまま渡せる
	SETLASTERROR(0)
	_r = EVAL("%(_name)(_args)")
	if GETLASTERROR() == 8 {
		return -1
	}

	// 戻り値の型で、返し方を決める
	_type = GETTYPEEX('_r')
	if _type == 4 {
		_mode = AYASAORI.ArrayResult(_name)
		if _mode == 'count'
			RES.RESULT = ARRAYSIZE(_r)
		elseif _mode == 'join'
			RES.RESULT = TOSTR(_r)
		AYASAORI.PutValues(_r)
	}
	elseif _type == 5 {
		RES.RESULT = SERIALIZEVAR('_r')
	}
	elseif _type != 0 {
		RES.RESULT = _r
	}

	// 正規表現の関数は、一致した部分文字列を Value0..n にも入れる
	case _name {
	when 'RE_GREP', 'RE_MATCH', 'RE_SEARCH' {
		if _r >= 1
			AYASAORI.PutValues(RE_GETSTR())
	}
	when 'RE_REPLACE', 'RE_REPLACEEX' {
		AYASAORI.PutValues(RE_GETSTR())
	}
	}
	return 0
}


/**	配列を Value0..n に入れる
 *
 *	@param	array	_argv 値(配列は引数に展開される)
 */
AYASAORI.PutValues
{
	for _i = 0; _i < ARRAYSIZE(_argv); _i++ {
		LETTONAME("RES.VALUE%(_i)", _argv[_i])
	}
	return
}


/**	引数の型ヒント
 *	一文字が一つの引数。書かれていない引数や関数は、文字列のまま渡す
 *	  s 文字列(そのまま)   i 整数(TOINT)   r 実数(TOREAL)
 *	  a 整数・実数・文字列を見分ける(TOAUTO)   x 同じ(TOAUTOEX。"007" や "+0900" は文字列のまま)
 *	大文字は省略できる引数。末尾にあって空のときは渡さない(REPLACE の第4引数など)
 *	小文字の引数が足りなければ、本体の関数が W0008 を出し、400 Bad Request になる
 *
 *	@param	string	_argv[0] 本体の関数名
 *	@return	string	型ヒント
 */
AYASAORI.ArgSig
{
	case _argv[0] {
	when 'ACOS', 'ASIN', 'ATAN', 'CEIL', 'COS', 'COSH', 'FLOOR', 'LOG', 'LOG10', 'ROUND', 'SIN', 'SINH', 'SQRT', 'TAN', 'TANH' { 'r' }
	when 'POW' { 'rr' }
	when 'BITWISE_NOT', 'CHARSETIDTOTEXT', 'CHR', 'SETTAMAHWND', 'SLEEP', 'TOBINSTR', 'TOHEXSTR' { 'i' }
	when 'BITWISE_AND', 'BITWISE_OR', 'BITWISE_SHIFT', 'BITWISE_XOR' { 'ii' }
	when 'GETSETTING' { 'a' }
	when 'GETTICKCOUNT', 'GETTIMEZONE', 'RAND', 'SRAND' { 'I' }
	when 'CHRCODE', 'PARSEHEADER' { 'sI' }
	when 'GETSTRBYTES' { 'sA' }
	when 'GETTIME' { 'IX' }
	when 'DIRECTSSTP' { 'isA' }
	when 'ERASE', 'SUBSTR' { 'sii' }
	when 'FSEEK', 'INSERT' { 'sis' }
	when 'STRSTR' { 'ssi' }
	when 'REPLACE', 'RE_REPLACE', 'RE_REPLACEEX' { 'sssI' }
	when 'RE_SPLIT', 'SPLIT' { 'ssI' }
	when 'FREADBIN', 'FREADENCODE' { 'siS' }
	when 'FWRITEBIN', 'FWRITEDECODE' { 'ssS' }
	when 'STRDECODE', 'STRENCODE' { 'sAS' }
	when 'EXECUTE', 'EXECUTE_WAIT' { 'sSS' }
	when 'DICLOAD', 'FENUM', 'HAN2ZEN', 'TOLOWER', 'TOUPPER', 'ZEN2HAN' { 'sS' }
	when 'GETFUNCLIST', 'GETSYSTEMFUNCLIST', 'GETVARLIST', 'RESTOREVAR' { 'S' }
	others { '' }
	}
}


/**	配列を返す関数の、Result の返し方
 *	ここに無い関数は Value0..n だけを返す
 *	  count Result に要素の数
 *	  join  Result に要素を , でつないだ文字列
 *
 *	@param	string	_argv[0] 本体の関数名
 *	@return	string	count / join / 空
 */
AYASAORI.ArrayResult
{
	case _argv[0] {
	when 'ARRAYDEDUP', 'ASEARCHEX', 'GETERRORLOG', 'RE_GETLEN', 'RE_GETPOS', 'RE_GETSTR', 'RE_SPLIT', 'SPLIT', 'SPLITPATH' { 'count' }
	when 'FATTRIB', 'GETVARLIST', 'LICENSE' { 'join' }
	others { '' }
	}
}


// ------ 個別 wrapper ------
// 戻り値の返し方が特殊な関数。AYASAORI.CallBuiltin より優先される。


// Value0 に LSO を返す
any
{
	if ARRAYSIZE(REQ.ARGS) < 1 {
		return -1
	}
	if ARRAYSIZE(REQ.ARGS) == 1
		RES.RESULT = ANY(REQ.ARGS[0])
	else
		RES.RESULT = ANY(REQ.ARGS)
	RES.VALUE0 = LSO
}

// レスポンスヘッダでまた文字列に戻るので意味がない
cvint
{
	if ARRAYSIZE(REQ.ARGS) < 1 {
		return -1
	}
	CVINT(REQ.ARGS[0])
	RES.RESULT = REQ.ARGS[0]
}

// レスポンスヘッダでまた文字列に戻るので意味がない
cvreal
{
	if ARRAYSIZE(REQ.ARGS) < 1 {
		return -1
	}
	CVREAL(REQ.ARGS[0])
	RES.RESULT = REQ.ARGS[0]
}

// 元々文字列なので意味がない
cvstr
{
	if ARRAYSIZE(REQ.ARGS) < 1 {
		return -1
	}
	CVSTR(REQ.ARGS[0])
	RES.RESULT = REQ.ARGS[0]
}

// ファイル終端まで読むと、Resultが無くなりValue0が"EOF"になる
fread
{
	if ARRAYSIZE(REQ.ARGS) < 1 {
		return -1
	}
	_result = FREAD(REQ.ARGS[0])
	if GETTYPE(_result) == 1
		RES.VALUE0 = "EOF"
	else
		RES.RESULT = _result
}

// AYASAORI.CallBuiltin は呼ぶ前に最後のエラーを 0 に戻すので、これは個別にしている
getlasterror
{
	RES.RESULT = GETLASTERROR()
}

setlasterror
{
	if ARRAYSIZE(REQ.ARGS) < 1 {
		return -1
	}
	SETLASTERROR(TOINT(REQ.ARGS[0]))
}

// 数字だけの文字列は数として調べる
gettype
{
	if ARRAYSIZE(REQ.ARGS) < 1 {
		return -1
	}
	if ISINTSTR(REQ.ARGS[0]) == 1
		RES.RESULT = GETTYPE(TOINT(REQ.ARGS[0]))
	elseif ISREALSTR(REQ.ARGS[0]) == 1
		RES.RESULT = GETTYPE(TOREAL(REQ.ARGS[0]))
	else
		RES.RESULT = GETTYPE(REQ.ARGS[0])
}

// 第4引数(曜日)は常に 0 を渡す。各引数は空だと 0 になる
getseccount
{
	_req0 = TOAUTO(REQ.ARGS[0])
	_req1 = TOAUTO(REQ.ARGS[1])
	_req2 = TOAUTO(REQ.ARGS[2])
	_req3 = 0
	_req4 = TOAUTO(REQ.ARGS[4])
	_req5 = TOAUTO(REQ.ARGS[5])
	_req6 = TOAUTO(REQ.ARGS[6])
	RES.RESULT = GETSECCOUNT(_req0,_req1,_req2,_req3,_req4,_req5,_req6)
}

// Result は空でない行の数、Value0..n は各行(空行は数えない)
readfmo
{
	_r = ''
	if REQ.ARGS[0] == '' {
		_r = READFMO()
	}
	elseif REQ.ARGS[1] == '' {
		_r = READFMO(REQ.ARGS[0])
	}
	else {
		_r = READFMO(REQ.ARGS[0], REQ.ARGS[1])
	}
	_a = SPLIT(_r, CHR(0xd)+CHR(0xa))
	_c = 0
	for _i = 0; _i < ARRAYSIZE(_a); _i++ {
		if _a[_i] != '' {
			LETTONAME("RES.VALUE%(_i)", _a[_i])
			_c++
		}
	}
	RES.RESULT = _c
}

// 第2引数の文字列の改行は\\r\\nとしてエスケープされていること
requestlib
{
	if ARRAYSIZE(REQ.ARGS) < 2 {
		return -1
	}
	RES.RESULT = REQUESTLIB(REQ.ARGS[0], REPLACE(REQ.ARGS[1], "\r\n", CRLF))
}
