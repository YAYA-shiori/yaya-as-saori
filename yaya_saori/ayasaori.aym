// https://gist.github.com/nikolat/1007538
// yaya.dll設定
#globaldefine AYAINFO_VERSION	0
#globaldefine AYAINFO_CHARSET	1
#globaldefine AYAINFO_PATH		2

#define PROTOCOL_VERSION	'1.0'				/* SAORIプロトコルバージョン */
#define PROTOCOL_SENDER		'AYASAORI'			/* Sender */
#define CRLF	CHR(0xd)+CHR(0xa)				/* 改行コード */

#define FUNC_UNDEFIND	0
#define FUNC_USER		1
#define FUNC_BUILTIN	2

#globaldefine STATUS_OK							'200 OK'
#globaldefine STATUS_NO_CONTENT					'204 No Content'
#globaldefine STATUS_BAD_REQUEST				'400 Bad Request'
#globaldefine STATUS_INTERNAL_SERVER_ERROR		'500 Internal Server Error'

/**	AYA API load
 *	初期化
 *
 *	@param	string	_argv[0] ライブラリのディレクトリパス
 */
load
{
	AYASAORI.PATH      = _argv[0]
	AYASAORI.LOADEDCLS = IARRAY()
	AYASAORI.VERSION   = PROTOCOL_VERSION
	AYASAORI.SENDER    = PROTOCOL_SENDER
}

/**	AYA API unload
 *	後始末
 */
unload
{
	AYASAORI.ClearRequest()
	ERASEVAR('REQ.HEADER')
	ERASEVAR('REQ.COMMAND')
	ERASEVAR('REQ.VERSION')
	ERASEVAR('REQ.PROTOCOL')

	// デストラクタコール
	foreach AYASAORI.LOADEDCLS; _cls {
		_func = "%(_cls).Unload"
		if ISFUNC(_func) {
			EVAL(_func)
		}
	}

	ERASEVAR('AYASAORI.PATH')
	ERASEVAR('AYASAORI.SENDER')
	ERASEVAR('AYASAORI.VERSION')
	ERASEVAR('AYASAORI.LOADEDCLS')
	ERASEVAR('AYASAORI.SYSFUNCS')
}



/**	AYA API request
 *	リクエストヘッダを解析し、指定の関数を呼び出して結果をレスポンスヘッダとして返す
 *
 *	@param	string	_argv[0] リクエストヘッダ文字列
 *	@return	string	レスポンスヘッダ文字列
 */
request
{
	REQ.HEADER = _argv[0]

	// ヘッダ全体を PARSEHEADER で一度に解析する(CRLF と LF のどちらでもよい)
	//   start    : リクエストライン
	//   header   : キー → 値のハッシュ(キーの大文字小文字は区別される)
	//   key      : ヘッダのキーの配列(出現順)
	//   rawvalue : ヘッダの値の配列(出現順)
	_parsed = PARSEHEADER(_argv[0])

	// 不正なヘッダ
	if GETTYPEEX('_parsed') != 5 {
		return AYASAORI.Response(STATUS_BAD_REQUEST)
	}
	_requestLine = CUTSPACE(_parsed['start'])
	if _requestLine == '' {
		return AYASAORI.Response(STATUS_BAD_REQUEST)
	}

	// リクエストラインの分析
	REQ.COMMAND  = _requestLine[0, ' SAORI']
	REQ.VERSION  = _requestLine[1, '/']
	REQ.PROTOCOL = 'SAORI/' + REQ.VERSION

	// REQ.CHARSET, REQ.SECURITYLEVEL, REQ.SENDER, REQ.ARGUMENT0..n, REQ.ARGS を作る
	AYASAORI.ReadHeader(_parsed)

	// { } の中で初めて代入した変数は、その中でしか使えないので、外で作っておく
	_response = ''
	case REQ.COMMAND {
	when 'GET Version' {
		if !ISVAR('REQ.CHARSET')
			REQ.CHARSET = ''
		RES.RESULT = GETSETTING('coreinfo.name') + '/' + GETSETTING('coreinfo.version')
		_response = AYASAORI.Response(STATUS_OK)
	}
	when 'EXECUTE' {
		_response = AYASAORI.Execute()
	}
	// 未知のリクエスト
	others {
		_response = AYASAORI.Response(STATUS_BAD_REQUEST)
	}
	}

	AYASAORI.ClearRequest()
	return _response
}


/**	PARSEHEADER の結果から、リクエストの変数を作る
 *	  REQ.CHARSET, REQ.SECURITYLEVEL, REQ.SENDER, REQ.ARGUMENT0..n : 値の前後の空白を取り除いたもの
 *	  REQ.ARGS : Argument1.. の配列(Argument0 は関数名なので含めない)。途切れた番号より先は含めない
 *	値の空白をそのまま渡したいときは、下の CUTSPACE を外す(PARSEHEADER は ": " の後ろをそのまま返す)
 *
 *	@param	hash	_argv[0] PARSEHEADER の結果
 */
AYASAORI.ReadHeader
{
	_parsed = _argv[0]
	_header = _parsed['header']
	_found  = 0

	// 正しい綴りのキーは、ハッシュから直接取る(これが普通のリクエスト)
	foreach 'Charset', 'SecurityLevel', 'Sender'; _name {
		if HASH_EXIST(_name, _header) {
			LETTONAME("REQ.%(TOUPPER(_name))", CUTSPACE(_header[_name]))
			_found += 1
		}
	}
	REQ.ARGS = IARRAY()
	_i = 0
	while HASH_EXIST("Argument%(_i)", _header) {
		_value = CUTSPACE(_header["Argument%(_i)"])
		LETTONAME("REQ.ARGUMENT%(_i)", _value)
		if _i > 0
			REQ.ARGS ,= _value
		_i++
	}
	_found += _i

	// 取れなかったキーがあるとき(大文字小文字が違う、同じキーが複数ある、番号が飛んでいる、
	// 知らないキーがある)だけ、全部のキーを大文字にして調べ直す
	if _found < ARRAYSIZE(_parsed['key']) {
		_keys   = _parsed['key']
		_values = _parsed['rawvalue']
		_count  = ARRAYSIZE(_keys)
		for _i = 0; _i < _count; _i++ {
			_key = TOUPPER(_keys[_i])
			if RE_MATCH(_key, 'CHARSET|SECURITYLEVEL|SENDER|ARGUMENT[0-9]+') {
				LETTONAME("REQ.%(_key)", CUTSPACE(_values[_i]))
			}
		}
		REQ.ARGS = IARRAY()
		_i = 1
		while ISVAR("REQ.ARGUMENT%(_i)") {
			REQ.ARGS ,= EVAL("REQ.ARGUMENT%(_i)")
			_i++
		}
	}
	return
}


/**	EXECUTE を処理する
 *	REQ.ARGUMENT0 の関数を呼び出し、レスポンスヘッダを返す
 *
 *	@return	string   レスポンスヘッダ文字列
 */
AYASAORI.Execute
{
	// externalの場合はExternalEvent.を接頭辞として明示的に付けた関数のみ有効とする
	// コンストラクタコールも上記に合わせて設定すること
	if TOLOWER(REQ.SECURITYLEVEL) == 'external' {
		REQ.ARGUMENT0 = 'ExternalEvent.' + REQ.ARGUMENT0
	}

	// 呼び出す関数を決める。ユーザ関数と本体のシステム関数だけが対象
	_name = REQ.ARGUMENT0
	_kind = ISFUNC(_name)
	if _kind == FUNC_UNDEFIND {
		// 大文字小文字の違う本体関数名(strlen → STRLEN)
		_found = AYASAORI.FindBuiltin(_name)
		if _found != '' {
			_name = _found
			_kind = FUNC_BUILTIN
		}
	}
	if _kind != FUNC_USER && _kind != FUNC_BUILTIN {
		return AYASAORI.Response(STATUS_NO_CONTENT)
	}

	// コンストラクタコール
	if STRSTR(REQ.ARGUMENT0, '.', 0) != -1 {
		_tmp = SPLIT(REQ.ARGUMENT0, '.', 2)
		_cls = _tmp[0]
		_mth = _tmp[1]
		if _mth == 'Load' {
			AYASAORI.LOADEDCLS ,= _cls
		} else {
			if ASEARCH(_cls, AYASAORI.LOADEDCLS) < 0 {
				_func = "%(_cls).Load"
				// モジュールロードの実行
				if ISFUNC(_func) {
					void EVAL(_func)
				}
				AYASAORI.LOADEDCLS ,= _cls
			}
		}
	}

	// 関数実行
	_result = 0
	if _kind == FUNC_BUILTIN
		_result = AYASAORI.CallBuiltin(_name)
	else
		_result = EVAL(_name)

	if _result == -1
		return AYASAORI.Response(STATUS_BAD_REQUEST)
	return AYASAORI.Response(STATUS_OK)
}


/**	大文字小文字を区別せずに本体のシステム関数を探す
 *	初回に GETSYSTEMFUNCLIST から表を作る
 *
 *	@param	string	_argv[0] 関数名
 *	@return	string	本体の関数名。無ければ空
 */
AYASAORI.FindBuiltin
{
	if !ISVAR('AYASAORI.SYSFUNCS') {
		AYASAORI.SYSFUNCS = IHASH()
		_list = GETSYSTEMFUNCLIST()
		foreach _list; _func {
			AYASAORI.SYSFUNCS[TOUPPER(_func)] = _func
		}
	}
	return AYASAORI.SYSFUNCS[TOUPPER(_argv[0])]
}


/**	リクエストの REQ.* を消す
 *	REQ.HEADER, REQ.COMMAND, REQ.VERSION, REQ.PROTOCOL は次のリクエストで上書きされる
 */
AYASAORI.ClearRequest
{
	ERASEVAR('REQ.CHARSET')
	ERASEVAR('REQ.SECURITYLEVEL')
	ERASEVAR('REQ.SENDER')
	ERASEVAR('REQ.ARGS')
	_i = 0
	while ISVAR("REQ.ARGUMENT%(_i)") {
		ERASEVAR("REQ.ARGUMENT%(_i)")
		_i++
	}
	return
}


/**	レスポンスヘッダを構築する
 *
 *	@param	string   _argv[0] ステータス
 *	@param	string[] _argv[1] Value[0..n]
 *	@return	string   レスポンスヘッダ文字列
 */
AYASAORI.Response
{
	_version  = ''
	_charset  = ''
	_sender   = ''
	_status   = ''
	if ISVAR('RES.VERSION') {
		_version = RES.VERSION
		ERASEVAR('RES.VERSION')
	} else {
		_version = AYASAORI.VERSION
	}
	if ISVAR('RES.CHARSET') {
		_charset = RES.CHARSET
		ERASEVAR('RES.CHARSET')
	} else {
		_charset = REQ.CHARSET
	}
	_unsupported = 127
	if CHARSETTEXTTOID(_charset) == _unsupported {
		_charset = GETSETTING('charset.output')
	}
	elseif !SETSETTING('charset.output', _charset) {
		_charset = GETSETTING('charset.output')
	}
	if ISVAR('RES.SENDER') {
		_sender = RES.SENDER
		ERASEVAR('RES.SENDER')
	} else {
		_sender = AYASAORI.SENDER
	}
	if ISVAR('RES.STATUS') {
		_status = RES.STATUS
		ERASEVAR('RES.STATUS')
	} else {
		_status = _argv[0]
	}
	_response  = ''
	_response += "SAORI/%(_version) %(_status)" + CRLF
	_response += "Charset: %(_charset)"         + CRLF
	_response += "Sender: %(_sender)"           + CRLF
	if ISVAR('RES.RESULT') {
		_response += "Result: %(RES.RESULT)" + CRLF
		ERASEVAR('RES.RESULT')
	}
	_i = 0
	while ISVAR("RES.VALUE%(_i)") {
		_response += "Value%(_i): " + EVAL("RES.VALUE%(_i)") + CRLF
		ERASEVAR("RES.VALUE%(_i)")
		_i++
	}
	_response + CRLF
}
